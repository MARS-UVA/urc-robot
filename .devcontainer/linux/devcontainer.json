{
  "name": "URC Robot \u2014 linux",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../.."
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspaces/urc-robot",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/urc-robot,type=bind",
  "runArgs": [
    "--shm-size=1g",
    "--network=host"
  ],
  "containerEnv": {
    "QT_X11_NO_MITSHM": "1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "COLCON_DEFAULTS_FILE": "/etc/colcon/defaults.yaml",
    "DISPLAY": "${localEnv:DISPLAY}"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,readonly"
  ]
}
