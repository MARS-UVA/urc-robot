{
  "name": "URC Robot \u2014 wsl",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../.."
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspaces/urc-robot",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/urc-robot,type=bind",
  "runArgs": [
    "--shm-size=1g"
  ],
  "containerEnv": {
    "QT_X11_NO_MITSHM": "1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "DISPLAY": "${localEnv:DISPLAY}",
    "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
    "XDG_RUNTIME_DIR": "/mnt/wslg/runtime-dir",
    "PULSE_SERVER": "unix:/mnt/wslg/PulseServer"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "mounts": [
    "source=/mnt/wslg,target=/mnt/wslg,type=bind",
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,readonly"
  ]
}
