{
  "name": "URC Robot \u2014 macos",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../.."
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspaces/urc-robot",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/urc-robot,type=bind",
  "runArgs": [
    "--shm-size=1g"
  ],
  "containerEnv": {
    "QT_X11_NO_MITSHM": "1",
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "COLCON_DEFAULTS_FILE": "/etc/colcon/defaults.yaml"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {
      "password": "vscode",
      "webPort": "6080",
      "vncPort": "5901"
    }
  },
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "URC desktop (noVNC)",
      "onAutoForward": "notify"
    }
  }
}
