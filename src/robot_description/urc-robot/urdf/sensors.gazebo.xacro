<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Sensor poses use ROS base_link axes. The CAD origin is not body-centered. -->
  <xacro:macro name="sensor_mount" params="name xyz rpy size mass:=0.075 mast:=false">
    <link name="${name}_link">
      <inertial>
        <mass value="${mass}"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <visual>
        <geometry><box size="${size}"/></geometry>
        <material name="sensor_dark"><color rgba="0.12 0.12 0.15 1"/></material>
      </visual>
      <xacro:if value="${mast}">
        <visual>
          <origin xyz="0 0 -0.04"/>
          <geometry><cylinder radius="0.012" length="0.04"/></geometry>
          <material name="sensor_dark"/>
        </visual>
      </xacro:if>
    </link>
    <joint name="${name}_mount_joint" type="fixed">
      <parent link="base_link"/><child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>
    <gazebo reference="${name}_mount_joint"><disableFixedJointLumping>true</disableFixedJointLumping></gazebo>
  </xacro:macro>

  <xacro:macro name="rover_camera" params="name xyz yaw rgbd:=false">
    <xacro:sensor_mount name="${name}" xyz="${xyz}" rpy="0 0 ${yaw}" size="0.025 0.09 0.025"/>
    <link name="${name}_optical_frame"/>
    <joint name="${name}_optical_joint" type="fixed">
      <parent link="${name}_link"/><child link="${name}_optical_frame"/>
      <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
    </joint>
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="${'rgbd_camera' if rgbd else 'camera'}">
        <always_on>true</always_on><update_rate>15</update_rate>
        <topic>/${name}</topic><gz_frame_id>${name}_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>${87 * pi / 180}</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>20.0</far></clip>
          <xacro:if value="${rgbd}">
            <depth_camera><clip><near>0.1</near><far>10.0</far></clip></depth_camera>
          </xacro:if>
          <camera_info_topic>/${name}/camera_info</camera_info_topic>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="rover_lidar" params="xyz">
    <xacro:sensor_mount name="rear_lidar" xyz="${xyz}" rpy="0 0 0" size="0.07 0.07 0.06" mass="0.25" mast="true"/>
    <gazebo reference="rear_lidar_link">
      <!-- Same functional 360-degree, 32-layer approximation as mars-jetson. -->
      <sensor name="rear_lidar" type="gpu_lidar">
        <always_on>true</always_on><update_rate>10</update_rate>
        <topic>/unilidar/cloud</topic><gz_frame_id>rear_lidar_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal><samples>360</samples><resolution>1</resolution><min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle></horizontal>
            <vertical><samples>32</samples><resolution>1</resolution><min_angle>${-pi / 12}</min_angle><max_angle>${pi / 12}</max_angle></vertical>
          </scan>
          <range><min>0.1</min><max>30.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
