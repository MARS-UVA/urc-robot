    <!-- Part chassis -->
    <visual>
      <origin xyz="-0.521839 0.646545 0.02613" rpy="0 -0 0"/>
      <geometry>
        <mesh filename="package://robot_description/urc-robot/assets/chassis.stl"/>
      </geometry>
      <material name="chassis_material">
        <color rgba="0.615686 0.811765 0.929412 1"/>
